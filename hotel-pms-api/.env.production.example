# ============================================================================
#  myhotel PMS — BACKEND production env template
#  Copy this to `.env` on your production server and fill in the real values.
#  NEVER commit the real .env (it's git-ignored).  Lines marked  <-- CHANGE
#  are the ones you must edit before going live.
# ============================================================================

APP_NAME="Your Hotel Name"                    # <-- CHANGE  shown in emails/UI
APP_ENV=production                            # MUST be production (not local)
APP_KEY=                                      # <-- CHANGE  run: php artisan key:generate
APP_DEBUG=false                               # MUST be false in production
APP_URL=https://api.yourhotel.com             # <-- CHANGE  your backend domain (https)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs — keep at "error" in prod so you don't fill disk with debug noise
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (use a managed/hosted Postgres with automatic backups) ---
DB_CONNECTION=pgsql
DB_HOST=your-db-host                          # <-- CHANGE
DB_PORT=5432
DB_DATABASE=hotel_pms
DB_USERNAME=your-db-user                      # <-- CHANGE
DB_PASSWORD=your-strong-db-password           # <-- CHANGE  use a long random password

# --- Sessions / cookies (secure cookies require https) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- File uploads ---
# `local` writes guest photos / logos to public/uploads on the server's disk.
# Fine on a normal VPS with persistent storage. On ephemeral/serverless hosts,
# switch to S3 (set the AWS_* block below) so uploads survive deploys.
FILESYSTEM_DISK=local

# --- Outgoing email (booking confirmations, invoices, owner flash) ---
# Use the hotel's real mailbox / SMTP — NOT the demo Gmail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com               # <-- CHANGE
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user                  # <-- CHANGE
MAIL_PASSWORD=your-smtp-password              # <-- CHANGE  (app password if Gmail/365)
MAIL_FROM_ADDRESS="bookings@yourhotel.com"    # <-- CHANGE
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend origin for CORS (so the web app can call this API) ---
FRONTEND_URL=https://app.yourhotel.com        # <-- CHANGE  your frontend domain(s), comma-separated

# --- Object storage (only if FILESYSTEM_DISK=s3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
